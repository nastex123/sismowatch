# ==============================================================================
# SismoWatch - Variables de Entorno del Sistema
# ==============================================================================

# Configuración del Entorno y Usuario Airflow (UID 50000 estándar Linux)
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=SismoAdmin2026!
AIRFLOW__CORE__FERNET_KEY=zUEIPAQWClV82k8paoU1O7alYWx7rqKi_W8RTKI0LIA=
AIRFLOW__WEBSERVER__SECRET_KEY=sismowatch_webserver_secret_key_2026_xyz
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false

# PostgreSQL Master Connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_master_pass_2026
POSTGRES_DB=sismowatch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Roles de Mínimo Privilegio en PostgreSQL
INGEST_USER=sismo_ingest
INGEST_PASSWORD=IngestSecurePass2026!
TRANSFORM_USER=sismo_transform
TRANSFORM_PASSWORD=TransformSecurePass2026!
API_USER=sismo_api
API_PASSWORD=ApiSecurePass2026!

# Credenciales de Usuarios de la Plataforma (Sembradas en Base de Datos)
ADMIN_EMAIL=admin@sismowatch.internal
ADMIN_PASSWORD=SismoAdmin2026!
VIEWER_EMAIL=viewer@sismowatch.internal
VIEWER_PASSWORD=SismoViewer2026!

# Seguridad y Autenticación JWT
JWT_SECRET_KEY=sismowatch_jwt_super_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Proveedor de Inteligencia Artificial para Reportes y Chatbot
# Opciones disponibles: 'opencode', 'gemini', 'fallback'
AI_PROVIDER=opencode
OPENCODE_CLI_PATH=/home/Coder/.opencode/bin/opencode
GEMINI_API_KEY=

# MinIO S3 Object Storage (Capa Bronze No Relacional)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=sismowatch_minio_admin
MINIO_ROOT_PASSWORD=SismoMinioPass2026!
MINIO_BRONZE_BUCKET=sismowatch-bronze
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_SECURE=false

# Red y CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PORT=8000
WEB_PORT=3000
AIRFLOW_PORT=8080
